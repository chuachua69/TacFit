# Supabase — copy this file to `.env` and fill with your project's values.
# Find them in the Supabase dashboard → Project Settings → API.
# The anon key is the public "anon/publishable" key (safe for the browser).
#
# For Vercel: add these same two variables in
#   Project → Settings → Environment Variables (then redeploy).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
